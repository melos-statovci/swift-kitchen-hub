# Public browser configuration for the isolated DUA Hub Vercel project.
# Set these in Vercel Project Settings > Environment Variables for the staging branch.
# Never put DATABASE_URL, JWT_SECRET, or staff passwords in VITE_* variables.
VITE_API_URL=https://<RAILWAY_DUA_STAGING_DOMAIN>
VITE_RESTAURANT_NAME=DUA Pizza
VITE_CURRENCY=EUR
VITE_LOCALE=sq-XK
VITE_BUSINESS_TIMEZONE=Europe/Belgrade
